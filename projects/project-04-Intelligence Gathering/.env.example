# Copy this file to .env. Empty API key enables local analysis only.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_BATCH_SIZE=50
AI_ENRICH_ITEMS=0
AI_ENRICH_LIMIT=100
GITHUB_TOKEN=
KB_NAMESPACE=ai-security
OPENALEX_MAILTO=
ARXIV_MAX_PAGES=2
OPENALEX_MAX_PAGES=2
ACADEMIC_MAX_RESULTS=200

# Relative paths are resolved from the project root by start.py.
OBSIDIAN_VAULT_PATH=knowledge/academic
OBSIDIAN_ACADEMIC_VAULT_PATH=knowledge/academic
OBSIDIAN_SOCIAL_VAULT_PATH=knowledge/social

# Optional external, compatible AI Scientist framework and Python interpreter.
AI_SCIENTIST_ROOT=
AI_SCIENTIST_PYTHON=
AI_SCIENTIST_KNOWLEDGE_BASE=
TIEBA_COOKIES=
